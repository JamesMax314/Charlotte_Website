{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "charlotte-website",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  /*
    The live domain, declared here rather than attached in the dashboard so the
    binding is in the repository and every deploy asserts it — dashboard-only
    routing is state nobody reading this can see.

    `custom_domain` makes Cloudflare create and own the DNS record, which is
    why there is no A or CNAME to write by hand. It is the apex only: the site
    canonicalises to the apex (see SITE_HOST in src/lib/site.ts), so serving it
    on www as well would publish the whole site at a second origin that
    robots.txt then has to keep out of the index. www wants a redirect rule,
    not a second copy of the site.
  */
  "routes": [
    {
      "pattern": "charlottewilkinsonart.co.uk",
      "custom_domain": true,
    },
  ],
  "services": [
    {
      // Self-reference, required by the incremental cache. Must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "charlotte-website",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "charlotte-website",
      // Local development ignores this; the remote deploy binds to it. Created
      // in WEUR on the artist's own Cloudflare account.
      "database_id": "38852db7-f670-4773-9e3d-24c544f9e31c",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      // Next's incremental cache. Create before first deploy:
      //   pnpm exec wrangler r2 bucket create charlotte-website-opennext-cache
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "charlotte-website-opennext-cache",
    },
    {
      // Artwork uploads. Private: served only through the /media route.
      //   pnpm exec wrangler r2 bucket create charlotte-website-media
      "binding": "MEDIA",
      "bucket_name": "charlotte-website-media",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
}
